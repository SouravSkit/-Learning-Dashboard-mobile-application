{
  "expo": {
    "name": "NewsFeed",
    "slug": "news-feed-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "newsfeed",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B5E4B"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.newsfeed.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1B5E4B"
      },
      "package": "com.newsfeed.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-video",
      "expo-sharing",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
